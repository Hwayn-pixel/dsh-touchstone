{
  "name": "dsh-touchstone",
  "version": "0.2.0",
  "description": "DSH 试金石：给「自改造」补上评测这一环——用一套金标准用例，把改动前 vs 改动后跑一遍、打分、对比，好就留、不好就撤。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "plugin",
    "eval",
    "evaluation",
    "regression",
    "benchmark",
    "test",
    "self-evolve",
    "prompt",
    "preset",
    "web-ui"
  ],
  "license": "MIT",
  "author": "Hwayn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hwayn-pixel/dsh-touchstone.git"
  },
  "bugs": {
    "url": "https://github.com/Hwayn-pixel/dsh-touchstone/issues"
  },
  "homepage": "https://github.com/Hwayn-pixel/dsh-touchstone#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "@types/node": "22",
    "@types/react": "~18.3.1",
    "react": "18.2.0"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "test"
  ],
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node build.mjs",
    "test": "node test/touchstone.test.mjs"
  }
